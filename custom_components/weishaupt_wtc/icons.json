{
    "entity": {
        "sensor": {
            "verbindung": {
                "default": "mdi:lan-connect",
                "state": {
                    "paused": "mdi:lan-pending",
                    "error": "mdi:lan-disconnect",
                    "suspended": "mdi:pause-circle"
                }
            },
            "naechste_wartung": {
                "default": "mdi:wrench-clock"
            }
        },
        "switch": {
            "sg_betriebsart_warmwasser": {
                "default": "mdi:water-boiler",
                "state": {
                    "off": "mdi:water-boiler-off"
                }
            },
            "abfragen_pausieren": {
                "default": "mdi:pause-circle-outline",
                "state": {
                    "on": "mdi:pause-circle"
                }
            }
        },
        "button": {
            "wartung_erledigt": {
                "default": "mdi:wrench-check"
            }
        }
    }
}
